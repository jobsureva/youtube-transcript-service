//@version=5
// XAUUSD Gold Confluence Signals v2
// A multi-confluence buy/sell indicator designed for gold (XAUUSD).
//
// v2 changes (after live 15m chart review):
//   - HTF filter is now PRICE vs a 1H EMA (fast to react) instead of a 4H EMA
//     cross (which lagged a full session and blocked entire intraday trends,
//     while allowing counter-trend sells at exhaustion lows).
//   - Two entry types per direction:
//       A. Pullback resumption : price reclaims the fast EMA after touching it
//       B. Continuation breakout: close beyond the recent N-bar high/low with
//          momentum, so sustained trends keep producing entries
//   - Exhaustion guards: no sells into washed-out RSI or when price is
//     stretched multiple ATRs below the slow EMA (mirrored for buys).
//   - Chop guard: EMAs must be separated by a minimum ATR fraction.
//
// Signals are evaluated on CONFIRMED bar closes only -> they do not repaint.
// Stop loss and take profits are ATR-based and printed on the chart and in alerts.

indicator("XAUUSD Gold Confluence Signals", shorttitle="GOLD-CS", overlay=true, max_labels_count=200)

// ---------------------------------------------------------------------------
// Inputs
// ---------------------------------------------------------------------------
grpTrend = "Trend Engine"
emaFastLen = input.int(21, "Fast EMA length", minval=1, group=grpTrend)
emaSlowLen = input.int(55, "Slow EMA length", minval=2, group=grpTrend)
useHtf     = input.bool(true, "Use higher-timeframe bias filter", group=grpTrend)
htfTf      = input.timeframe("60", "Higher timeframe", group=grpTrend, tooltip="Bias = HTF close vs HTF EMA. 60 (1H) reacts fast enough for 15m charts; 240 lags badly.")
htfEmaLen  = input.int(50, "HTF EMA length", minval=2, group=grpTrend)
minSepAtr  = input.float(0.1, "Min EMA separation (x ATR)", minval=0.0, step=0.05, group=grpTrend, tooltip="EMAs must be at least this far apart (in ATRs) before any signal fires. Filters flat chop.")

grpMom = "Entries"
rsiLen           = input.int(14, "RSI length", minval=2, group=grpMom)
pullbackLookback = input.int(8, "Pullback lookback (bars)", minval=1, group=grpMom, tooltip="Entry A: price must have touched the fast EMA within this many bars.")
breakoutLen      = input.int(10, "Breakout lookback (bars)", minval=2, group=grpMom, tooltip="Entry B: close beyond the highest/lowest of this many prior bars continues the trend.")
cooldownBars     = input.int(6, "Min bars between signals", minval=0, group=grpMom)

grpGuard = "Exhaustion Guards"
maxStretchAtr = input.float(3.0, "Max distance from slow EMA (x ATR)", minval=0.5, step=0.25, group=grpGuard, tooltip="No new signals when price is already stretched this many ATRs beyond the slow EMA (avoids chasing exhaustion moves).")
rsiMaxBuy     = input.float(75, "Block buys when RSI above", minval=50, maxval=100, group=grpGuard)
rsiMinSell    = input.float(25, "Block sells when RSI below", minval=0, maxval=50, group=grpGuard)

grpRisk = "Risk Levels (ATR-based)"
atrLen = input.int(14,   "ATR length", minval=1, group=grpRisk)
slMult = input.float(1.5, "Stop loss (x ATR)", minval=0.1, step=0.1, group=grpRisk)
tp1RR  = input.float(1.0, "Take profit 1 (R multiple)", minval=0.1, step=0.1, group=grpRisk)
tp2RR  = input.float(2.0, "Take profit 2 (R multiple)", minval=0.1, step=0.1, group=grpRisk)

grpSess = "Session Filter (UTC)"
useSession = input.bool(true, "Trade only London + New York sessions", group=grpSess)
londonSess = input.session("0700-1600", "London session", group=grpSess)
nySess     = input.session("1200-2100", "New York session", group=grpSess)

grpUi = "Display"
showLevels = input.bool(true, "Show entry / SL / TP lines", group=grpUi)
showDash   = input.bool(true, "Show dashboard", group=grpUi)
showBg     = input.bool(true, "Tint background by trend", group=grpUi)

// ---------------------------------------------------------------------------
// Trend & bias
// ---------------------------------------------------------------------------
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
atr     = ta.atr(atrLen)

trendUp   = emaFast > emaSlow
trendDown = emaFast < emaSlow
sepOk     = math.abs(emaFast - emaSlow) > atr * minSepAtr

// Higher-timeframe bias from LAST CONFIRMED HTF bar (no repainting / no lookahead):
// price above/below a single HTF EMA reacts within a few bars of a real trend turn.
htfClose = request.security(syminfo.tickerid, htfTf, close[1], barmerge.gaps_off, barmerge.lookahead_off)
htfEma   = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfEmaLen)[1], barmerge.gaps_off, barmerge.lookahead_off)
htfUp    = not useHtf or htfClose > htfEma
htfDown  = not useHtf or htfClose < htfEma

biasUp   = trendUp and htfUp and sepOk
biasDown = trendDown and htfDown and sepOk

// ---------------------------------------------------------------------------
// Entry triggers
// ---------------------------------------------------------------------------
rsi = ta.rsi(close, rsiLen)

// Entry A: pullback resumption — price touched the fast EMA recently and now
// closes back through it in the trend direction with momentum on side.
pullbackBuy  = ta.barssince(low  <= emaFast) <= pullbackLookback
pullbackSell = ta.barssince(high >= emaFast) <= pullbackLookback
resumeBuy  = pullbackBuy  and ta.crossover(close, emaFast)  and close > open and rsi > 45
resumeSell = pullbackSell and ta.crossunder(close, emaFast) and close < open and rsi < 55

// Entry B: continuation breakout — trend keeps producing entries instead of
// requiring a one-time RSI crossover.
hh = ta.highest(high, breakoutLen)[1]
ll = ta.lowest(low, breakoutLen)[1]
breakBuy  = close > hh and rsi > 52
breakSell = close < ll and rsi < 48

// Exhaustion guards: don't chase moves already stretched from value, and don't
// sell into washed-out RSI (this is what fires shorts at V-bottoms) or buy into
// blow-off RSI.
stretchBuyOk  = (close - emaSlow) < atr * maxStretchAtr
stretchSellOk = (emaSlow - close) < atr * maxStretchAtr
guardBuy  = stretchBuyOk  and rsi < rsiMaxBuy
guardSell = stretchSellOk and rsi > rsiMinSell

inLondon  = not na(time(timeframe.period, londonSess, "Etc/UTC"))
inNY      = not na(time(timeframe.period, nySess, "Etc/UTC"))
inSession = not useSession or inLondon or inNY

// ---------------------------------------------------------------------------
// Signals (confirmed bars only -> non-repainting)
// ---------------------------------------------------------------------------
var int lastSignalBar = -99999
canSignal = bar_index - lastSignalBar >= cooldownBars

rawBuy  = biasUp   and (resumeBuy  or breakBuy)  and guardBuy  and inSession
rawSell = biasDown and (resumeSell or breakSell) and guardSell and inSession

buySignal  = rawBuy  and canSignal and barstate.isconfirmed
sellSignal = rawSell and not rawBuy and canSignal and barstate.isconfirmed

if buySignal or sellSignal
    lastSignalBar := bar_index

// ---------------------------------------------------------------------------
// Trade levels
// ---------------------------------------------------------------------------
var float entryP = na
var float slP    = na
var float tp1P   = na
var float tp2P   = na
var int   dir    = 0 // 1 = long active, -1 = short active, 0 = flat

riskAmt = atr * slMult

if buySignal
    entryP := close
    slP    := close - riskAmt
    tp1P   := close + riskAmt * tp1RR
    tp2P   := close + riskAmt * tp2RR
    dir    := 1

if sellSignal
    entryP := close
    slP    := close + riskAmt
    tp1P   := close - riskAmt * tp1RR
    tp2P   := close - riskAmt * tp2RR
    dir    := -1

// Retire the level lines once the stop or final target is hit
if dir == 1 and not buySignal and (low <= slP or high >= tp2P)
    dir := 0
if dir == -1 and not sellSignal and (high >= slP or low <= tp2P)
    dir := 0

// ---------------------------------------------------------------------------
// Plotting
// ---------------------------------------------------------------------------
colBull = color.new(#26a69a, 0)
colBear = color.new(#ef5350, 0)

plot(emaFast, "Fast EMA", color=color.new(color.orange, 0), linewidth=2)
plot(emaSlow, "Slow EMA", color=color.new(color.blue, 0), linewidth=2)

bgcolor(showBg and biasUp ? color.new(#26a69a, 94) : showBg and biasDown ? color.new(#ef5350, 94) : na)

plotshape(buySignal,  "Buy",  style=shape.triangleup,   location=location.belowbar, color=colBull, size=size.small, text="BUY")
plotshape(sellSignal, "Sell", style=shape.triangledown, location=location.abovebar, color=colBear, size=size.small, text="SELL")

showLines = showLevels and dir != 0
plot(showLines ? entryP : na, "Entry", style=plot.style_linebr, color=color.new(color.gray, 0),  linewidth=1)
plot(showLines ? slP    : na, "Stop",  style=plot.style_linebr, color=colBear,                   linewidth=1)
plot(showLines ? tp1P   : na, "TP1",   style=plot.style_linebr, color=color.new(#26a69a, 40),    linewidth=1)
plot(showLines ? tp2P   : na, "TP2",   style=plot.style_linebr, color=colBull,                   linewidth=1)

fmt(float p) => str.tostring(p, format.mintick)

buyKind  = resumeBuy  ? "pullback" : "breakout"
sellKind = resumeSell ? "pullback" : "breakout"

if buySignal
    label.new(bar_index, low, "BUY (" + buyKind + ")\nEntry " + fmt(entryP) + "\nSL " + fmt(slP) + "\nTP1 " + fmt(tp1P) + "\nTP2 " + fmt(tp2P), style=label.style_label_up, color=color.new(#26a69a, 10), textcolor=color.white, size=size.small)
if sellSignal
    label.new(bar_index, high, "SELL (" + sellKind + ")\nEntry " + fmt(entryP) + "\nSL " + fmt(slP) + "\nTP1 " + fmt(tp1P) + "\nTP2 " + fmt(tp2P), style=label.style_label_down, color=color.new(#ef5350, 10), textcolor=color.white, size=size.small)

// ---------------------------------------------------------------------------
// Dashboard
// ---------------------------------------------------------------------------
var table dash = table.new(position.top_right, 2, 6, border_width=1)
if showDash and barstate.islast
    hdrBg = color.new(color.gray, 70)
    upBg  = color.new(#26a69a, 70)
    dnBg  = color.new(#ef5350, 70)
    neuBg = color.new(color.gray, 85)
    table.cell(dash, 0, 0, "GOLD-CS v2", bgcolor=hdrBg, text_color=color.white, text_size=size.small)
    table.cell(dash, 1, 0, syminfo.ticker, bgcolor=hdrBg, text_color=color.white, text_size=size.small)
    table.cell(dash, 0, 1, "Chart trend", bgcolor=neuBg, text_size=size.small)
    table.cell(dash, 1, 1, trendUp ? "UP" : trendDown ? "DOWN" : "FLAT", bgcolor=trendUp ? upBg : trendDown ? dnBg : neuBg, text_size=size.small)
    table.cell(dash, 0, 2, "HTF bias (" + htfTf + ")", bgcolor=neuBg, text_size=size.small)
    table.cell(dash, 1, 2, htfClose > htfEma ? "UP" : "DOWN", bgcolor=htfClose > htfEma ? upBg : dnBg, text_size=size.small)
    table.cell(dash, 0, 3, "Signals", bgcolor=neuBg, text_size=size.small)
    table.cell(dash, 1, 3, biasUp ? "BUYS ONLY" : biasDown ? "SELLS ONLY" : "STAND ASIDE", bgcolor=biasUp ? upBg : biasDown ? dnBg : neuBg, text_size=size.small)
    table.cell(dash, 0, 4, "RSI", bgcolor=neuBg, text_size=size.small)
    table.cell(dash, 1, 4, str.tostring(rsi, "#.#"), bgcolor=rsi > 50 ? upBg : dnBg, text_size=size.small)
    table.cell(dash, 0, 5, "Session", bgcolor=neuBg, text_size=size.small)
    table.cell(dash, 1, 5, inSession ? "ACTIVE" : "OFF-HOURS", bgcolor=inSession ? upBg : neuBg, text_size=size.small)

// ---------------------------------------------------------------------------
// Alerts (real-time, fire once per confirmed bar close)
// ---------------------------------------------------------------------------
alertcondition(buySignal,  "Gold BUY signal",  "XAUUSD BUY signal (GOLD-CS)")
alertcondition(sellSignal, "Gold SELL signal", "XAUUSD SELL signal (GOLD-CS)")

if buySignal
    alert("XAUUSD BUY (" + buyKind + ") | Entry " + fmt(entryP) + " | SL " + fmt(slP) + " | TP1 " + fmt(tp1P) + " | TP2 " + fmt(tp2P), alert.freq_once_per_bar_close)
if sellSignal
    alert("XAUUSD SELL (" + sellKind + ") | Entry " + fmt(entryP) + " | SL " + fmt(slP) + " | TP1 " + fmt(tp1P) + " | TP2 " + fmt(tp2P), alert.freq_once_per_bar_close)
